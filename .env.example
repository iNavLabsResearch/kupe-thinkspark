# Copy to .env and paste your key. Same Sarvam key as kupe-tts uses.
SARVAM_API_KEY=your_sarvam_api_key_here
# Optional:
# SARVAM_MODEL=gemma4      # open-source model on the Sarvam v2 endpoint
# SARVAM_STREAM=1          # 1 = live SSE streaming (default)
# HF_TOKEN=hf_...          # optional; public dataset fetch works without it
# HF_DATASET_ID=anuj-inavlabs/kupe-thinkspark
